<style>
  .row { flex-direction: row; align-items: center; gap: 12; padding-top: 10; padding-bottom: 10; padding-left: 10; padding-right: 10; background-color: #FBF7F0; border-radius: 40; border-width: 2; border-color: #2B2A33; }
  .btn { align-items: center; justify-content: center; padding-top: 17; padding-bottom: 17; padding-left: 34; padding-right: 34; border-radius: 40; cursor: pointer; }
  .ink { background-color: #2B2A33; }
  .quiet { border-width: 2; border-color: #2B2A33; }
  .label { font-family: nunito; font-size: 24; font-weight: 700; }
</style>
<div class="row">
  <div id="btn-done" class="btn ink" style="display: none"><div class="label" style="color: #FBF7F0">Done placing</div></div>
  <div id="btn-got" class="btn ink" style="display: none"><div class="label" style="color: #FBF7F0">Got it</div></div>
  <div id="btn-back" class="btn quiet" style="display: none"><div class="label" style="color: #2B2A33">Back</div></div>
  <div id="btn-missed" class="btn quiet" style="display: none"><div class="label" style="color: #2B2A33">Missed</div></div>
</div>
