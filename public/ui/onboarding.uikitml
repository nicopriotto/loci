<style>
  .root { flex-direction: column; align-items: center; width: 380; height: 420; padding-top: 22; padding-bottom: 30; padding-left: 36; padding-right: 36; background-color: #FBF7F0; border-radius: 22; border-width: 2; border-color: #2B2A33; }
  .spacer { width: 100%; height: 92; }
  .tag { color: #2B2A33; font-family: nunito; font-size: 19; font-weight: 600; line-height: 1.3; text-align: center; }
  .primary { flex-direction: column; align-items: center; width: 100%; margin-top: 26; padding-top: 16; padding-bottom: 14; background-color: #2B2A33; border-radius: 40; cursor: pointer; }
  .primary-label { color: #FBF7F0; font-family: nunito; font-size: 24; font-weight: 700; }
  .primary-sub { color: #C7DDF2; font-family: nunito; font-size: 15; font-weight: 600; margin-top: 1; }
  .secondary { align-items: center; justify-content: center; width: 100%; margin-top: 12; padding-top: 12; padding-bottom: 12; border-radius: 40; border-width: 2; border-color: #2B2A33; cursor: pointer; }
  .secondary-label { color: #2B2A33; font-family: nunito; font-size: 19; font-weight: 700; }
  .hint { flex-direction: row; align-items: center; justify-content: center; gap: 12; margin-top: 22; }
  .dots { flex-direction: row; align-items: center; justify-content: center; width: 44; gap: 22; }
  .dot { width: 10; height: 10; border-radius: 5; border-width: 2; border-color: #2B2A33; }
  .hint-text { color: #6E6A78; font-family: nunito; font-size: 15; font-weight: 600; }
</style>
<div class="root">
  <div id="spacer" class="spacer"></div>
  <div id="tagline" class="tag">Place what you want to remember in the room around you.</div>
  <div id="primary" class="primary">
    <div id="primary-label" class="primary-label">Try the demo deck</div>
    <div id="primary-sub" class="primary-sub">Inside the Cell, 8 concepts</div>
  </div>
  <div id="secondary" class="secondary" style="display: none">
    <div id="secondary-label" class="secondary-label">Start over</div>
  </div>
  <div id="hint" class="hint">
    <div id="dots" class="dots">
      <div id="dot-a" class="dot" style="background-color: #F4C7C3"></div>
      <div id="dot-b" class="dot" style="background-color: #C8E6D0"></div>
    </div>
    <div class="hint-text">Pinch to select</div>
  </div>
</div>
